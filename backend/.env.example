# Copiar para .env e preencher

# Porta do servidor
PORT=3001

# Segredo para assinar tokens JWT (obrigatorio com NODE_ENV=production;
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troca-isto-por-um-segredo-aleatorio

# Configuracao SMTP para envio real de emails.
# Se nao definir SMTP_HOST, os emails sao simulados (impressos na consola) - util em desenvolvimento.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=o-teu-email@gmail.com
# SMTP_PASS=a-tua-password-de-aplicacao
# SMTP_FROM=esta-na-agenda@estcb.pt
